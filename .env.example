# Theia configuration. Copy to `.env` for local development (or `.env.production`
# for the production compose stack) and fill in the values. Never commit the real file.
# Generate secrets with: openssl rand -hex 32

# --- Core -------------------------------------------------------------------
# Postgres connection string.
DATABASE_URL=postgres://theia:theia@localhost:5433/theia_site
# Signs admin/customer sessions. Required.
PAYLOAD_SECRET=
# Public origin of the site (scheme + host, no trailing slash). Used for
# canonical URLs, sitemap, emails and payment return URLs.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Secret for admin Live Preview / draft links.
PREVIEW_SECRET=

# --- First admin user (created on first start if no admin exists) -----------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email (SMTP). Without SMTP_HOST, emails are printed to the server log. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=ventas@example.com
EMAIL_FROM_NAME=Theia

# --- Payments ---------------------------------------------------------------
# "sandbox" simulates PayPal and Bancard so checkout works without merchant
# accounts. "production" uses the real gateways (keys below are then required
# for the method to be offered). Bank transfer and Western Union need no keys.
PAYMENT_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
BANCARD_PUBLIC_KEY=
BANCARD_PRIVATE_KEY=
