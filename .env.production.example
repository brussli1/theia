# Theia production configuration (#18).
# Copy this file to .env.production and fill in the values, then:
#   docker compose --env-file .env.production -f compose.prod.yaml up -d
# This file is a template — the real .env.production is gitignored and must
# never be committed. Generate secrets with `openssl rand -hex 32`.
# See docs/deploy.md for the full walkthrough.

# Public origin served by Caddy (no scheme). Use a real domain for auto TLS,
# a bare IP for plain HTTP bring-up, or "localhost" (served over HTTPS with a
# locally-issued certificate).
DOMAIN=theia.example.com

# Postgres password for the "theia" role (generate one).
POSTGRES_PASSWORD=

# --- Backend ---------------------------------------------------------------
# Payments (#12): "sandbox" simulates the gateways so the flow runs without
# merchant accounts; "production" wires Bancard vPOS (cards) and PayPal REST.
# Going live requires the keys below (see docs/adr/0001-payments.md).
PAYMENT_MODE=sandbox
BANCARD_PUBLIC_KEY=
BANCARD_PRIVATE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Quote notifications (#13): a channel is enabled by its credentials — SMTP
# when SMTP_HOST is set, WhatsApp when WHATSAPP_TOKEN + WHATSAPP_PHONE_ID are
# set. With nothing configured the composed message is logged instead
# (docs/adr/0002-quotes.md). The recipients below are the PRD-configured
# business contacts (same defaults as backend config.py).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL_TO=td.phakos@gmail.com
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
NOTIFICATION_WHATSAPP_TO=595971282908

# Accounts (#14): JWT signing secret — production refuses to start signing
# without it (app/core/security.py). Generate one.
JWT_SECRET=

# Admin panel (#15): bootstrapped at startup when both are set; rotating the
# password is restarting with a new value (app/core/admin.py).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Frontend --------------------------------------------------------------
# The single origin knob: canonical / Open Graph / sitemap base, the backend's
# gateway-return URLs and media URLs are all derived from it. Must equal the
# public origin (scheme + host, no trailing slash). Changing it requires a
# rebuild (`docker compose ... build frontend`) because robots.txt is baked
# at image build time.
SITE_URL=https://theia.example.com
